# Containerfile.dev — development image.
#
# Spec: Containerfile.5
#   https://github.com/containers/common/blob/main/docs/Containerfile.5.md
# Buildable natively by Buildah and `podman build`; no external frontend.
#
# Build:   podman build -f deployments/containers/Containerfile.dev -t terraform-provider-powerdns-dev:local .
# Run via: deployments/compose/compose.dev.yml (Compose Specification).
#
# Every version here is pinned, and the base image is pinned by digest rather
# than tag: golang:1.26-trixie is a moving reference, the digest is not.
# `scripts/check-pins.sh` rejects an unpinned FROM.

ARG GO_IMAGE=golang:1.26-trixie@sha256:4ee9ffa999b4583ce281939cdff828763083610292f252279a0cee77473bd9a7

ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GOVULNCHECK_VERSION=v1.6.0
ARG OSV_SCANNER_VERSION=v2.4.0
ARG TFPLUGINDOCS_VERSION=v0.25.0
ARG GORELEASER_VERSION=v2.17.1
ARG TASK_VERSION=v3.52.0
ARG GOTESTSUM_VERSION=v1.13.0
ARG GOPLS_VERSION=v0.23.0
ARG ACTIONLINT_VERSION=v1.7.12
ARG TERRAFORM_VERSION=1.15.8
ARG OPENTOFU_VERSION=1.12.5
ARG TERRAGRUNT_VERSION=1.1.1
ARG NODE_MAJOR=22
ARG MARKDOWNLINT_VERSION=0.23.2
ARG CSPELL_VERSION=10.0.1
ARG COMMITLINT_VERSION=21.2.1
ARG COMMITLINT_CONFIG_VERSION=21.2.0
ARG UV_VERSION=0.11.33
ARG RUFF_VERSION=0.16.0
ARG TY_VERSION=0.0.64
ARG SEMGREP_VERSION=1.172.0
ARG PODMAN_PY_VERSION=5.8.0

FROM ${GO_IMAGE} AS dev

ARG GOLANGCI_LINT_VERSION
ARG GOVULNCHECK_VERSION
ARG OSV_SCANNER_VERSION
ARG TFPLUGINDOCS_VERSION
ARG GORELEASER_VERSION
ARG TASK_VERSION
ARG GOTESTSUM_VERSION
ARG GOPLS_VERSION
ARG ACTIONLINT_VERSION
ARG TERRAFORM_VERSION
ARG OPENTOFU_VERSION
ARG TERRAGRUNT_VERSION
ARG NODE_MAJOR
ARG MARKDOWNLINT_VERSION
ARG CSPELL_VERSION
ARG COMMITLINT_VERSION
ARG COMMITLINT_CONFIG_VERSION
ARG UV_VERSION
ARG RUFF_VERSION
ARG TY_VERSION
ARG SEMGREP_VERSION
ARG PODMAN_PY_VERSION

ENV GOFLAGS="-buildvcs=false" \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    CHECKPOINT_DISABLE=1 \
    TF_IN_AUTOMATION=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/root/.local/bin:${PATH}"

# OCI image-spec annotations.
LABEL org.opencontainers.image.title="terraform-provider-powerdns-dev" \
      org.opencontainers.image.description="Development image for terraform-provider-powerdns." \
      org.opencontainers.image.source="https://github.com/ioplane/terraform-provider-powerdns" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="ioplane"

# Base OS tooling.
#
# dnsutils and postgresql-client are not incidental: an HTTP 200 proves the API
# accepted a request, not that DNS answers or that a row exists. The behaviour
# test layer needs dig and psql.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        git ca-certificates tzdata make bash curl unzip jq gnupg \
        dnsutils postgresql-client python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Node.js for the documentation linters and commitlint.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && chmod a+r /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Terraform, OpenTofu and Terragrunt. Both engines are installed: OpenTofu is a
# co-equal target, not an afterthought.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) a=amd64 ;; arm64) a=arm64 ;; *) echo "unsupported arch $arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${a}.zip" -o /tmp/tf.zip; \
    unzip -d /usr/local/bin /tmp/tf.zip; \
    curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${a}.zip" -o /tmp/tofu.zip; \
    unzip -d /usr/local/bin /tmp/tofu.zip tofu; \
    curl -fsSL "https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_${a}" -o /usr/local/bin/terragrunt; \
    chmod +x /usr/local/bin/terragrunt; \
    rm -f /tmp/tf.zip /tmp/tofu.zip; \
    terraform version; tofu version; terragrunt --version

# Go tooling.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
 && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
 && go install github.com/google/osv-scanner/v2/cmd/osv-scanner@${OSV_SCANNER_VERSION} \
 && go install github.com/hashicorp/terraform-plugin-docs/cmd/tfplugindocs@${TFPLUGINDOCS_VERSION} \
 && go install github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION} \
 && go install github.com/go-task/task/v3/cmd/task@${TASK_VERSION} \
 && go install golang.org/x/tools/gopls@${GOPLS_VERSION} \
 && go install gotest.tools/gotestsum@${GOTESTSUM_VERSION} \
 && go install github.com/rhysd/actionlint/cmd/actionlint@${ACTIONLINT_VERSION}

# Documentation linters and commitlint.
# Pinned, and installed without lifecycle scripts. `@latest` here meant the
# documentation linter could change its mind between two builds of the same
# image, and CI could not agree with a version that has no name.
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --ignore-scripts \
        markdownlint-cli2@${MARKDOWNLINT_VERSION} \
        cspell@${CSPELL_VERSION} \
        @commitlint/cli@${COMMITLINT_VERSION} \
        @commitlint/config-conventional@${COMMITLINT_CONFIG_VERSION}

# Python toolchain. uv installs and manages; ruff lints and formats; ty type
# checks. podman-py is a runtime dependency of the lab automation, so it goes
# into the interpreter rather than the tool environment.
RUN --mount=type=cache,target=/root/.cache/uv \
    curl -fsSL https://astral.sh/uv/${UV_VERSION}/install.sh | sh \
 && mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/ \
 && uv --version

RUN --mount=type=cache,target=/root/.cache/uv \
    uv tool install --python 3.12 "ruff==${RUFF_VERSION}" \
 && uv tool install --python 3.12 "ty==${TY_VERSION}" \
 && uv tool install --python 3.12 yamllint \
 && uv tool install --python 3.12 "semgrep==${SEMGREP_VERSION}" \
 && uv pip install --system --break-system-packages "podman==${PODMAN_PY_VERSION}"

WORKDIR /app
VOLUME /app

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD pgrep -x sleep >/dev/null || exit 1

CMD ["sleep", "infinity"]
