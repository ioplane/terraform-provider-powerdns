.terraform/
# Terragrunt's download cache and the generated files beside it. All of it is
# rebuilt by `task e2e:up` and a stale copy is worse than none: a module cached
# from an earlier run is why one e2e test passed while asserting the opposite
# of what it meant to.
.terragrunt-cache/
test/e2e/.mirror/
test/e2e/.released/
test/e2e/.token
test/e2e/.tls/
test/e2e/**/.terraform.lock.hcl
test/e2e/**/backend.tf
test/e2e/**/provider.tf
test/e2e/**/versions.tf

# uv creates this in the working tree when a task runs `uv run`.
.venv/

# Task's local checksum cache for `sources`/`generates`.
.task/
.token
.tls/
test/e2e/.home/
